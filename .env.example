# DB API Marketplace — https://developers.deutschebahn.com
# 1. Crea una aplicación → obtén DB_CLIENT_ID y DB_API_KEY.
# 2. Suscribe las APIs "Timetables" (v1) y "StationData" (StaDa, v2).
# 3. Copia este archivo a `.env` y rellena tus credenciales (NUNCA subir .env al repo).
DB_CLIENT_ID=
DB_API_KEY=

# Rate limit: plan Free = 60 req/min (55 deja margen).
DB_RATE_PER_MIN=55

# Rotación de jobs sobre ~6000 estaciones (segundos).
# FCHG (cambios en vivo): más frecuente si la estación tuvo actividad.
FCHG_TTL_ACTIVA=60
FCHG_TTL_FONDO=900
# Plan por hora (Sollfahrplan): 1 petición por estación y hora.
PLAN_TTL_SEG=3600
# Catálogo StaDa: condiciones de uso → 1 consulta/día.
CATALOG_TTL_SEG=86400
# 0 = todas las estaciones del catálogo; pon un número para probar.
STADA_MAX_ESTACIONES=0

# Ventanas y umbrales del detector (segundos)
VENTANA_SEG=900
LATE_TOLERANCE_SEG=120
UMBRAL_SEGUNDOS=180
# Horizonte de predicción: solo se alerta de lo que empieza en <= 30 min.
HORIZONTE_SEG=1800
OCUPACION_TTL_SEG=600
EVENTO_TTL_SEG=7200
